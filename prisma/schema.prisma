generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Batch {
  id          String   @id @default(uuid())
  title       String
  description String?
  duration    String?
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("upcoming")

  enrollments Enrollment[]
  
  liveClasses LiveClass[]
}

model Course {
  id          String   @id @default(uuid())
  title       String
  description String?
  thumbnail   String?

  lectures    Lecture[]
  enrollments Enrollment[]
}


model AdminRequest {
  id             String   @id @default(uuid())

  name           String
  email          String
  

  fatherName     String?
  cnic           String?
  dateOfBirth    String?
  gender         String?

  whatsapp       String?
  postalAddress  String?

  lastQual       String?
  passingYear    String?
  institute      String?

  emergencyName  String?
  emergencyRel   String?
  emergencyPhone String?

  batchName        String

  selectedCourses  String // JSON string or comma separated ids

  status         String @default("pending")

  createdAt      DateTime @default(now())

}


model User {
  id          String @id @default(uuid())

  name        String
  email       String @unique
  password    String

  role        String @default("student")


  enrollments Enrollment[]
  lectureProgress LectureProgress[]
}



model Enrollment {
  id        String @id @default(uuid())

  userId    String
  batchId   String
  courseId  String

  enrolledAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id])
  batch     Batch  @relation(fields: [batchId], references: [id])
  course    Course @relation(fields: [courseId], references: [id])

  @@unique([userId, batchId, courseId])
}



model Lecture {
  id          String @id @default(uuid())

  title       String
  description String?
  videoUrl    String?

  courseId    String

  course      Course @relation(fields: [courseId], references: [id])

  progress    LectureProgress[]
}

model LectureProgress {
  id          String @id @default(uuid())

  userId      String
  lectureId   String

  completed   Boolean @default(false)

  user        User    @relation(fields: [userId], references: [id])
  lecture     Lecture @relation(fields: [lectureId], references: [id])

  @@unique([userId, lectureId])
}



model LiveClass {
  id          String @id @default(uuid())

  batchId     String

  title       String
  meetingLink String

  startTime   DateTime
  endTime     DateTime

  batch       Batch @relation(fields: [batchId], references: [id])
}